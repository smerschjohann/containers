#!/command/with-contenv sh
set -e

. /venv/main/bin/activate

case "${COMFYUI_ENABLED:-1}" in
    0|false|False|FALSE|no|No|NO|off|Off|OFF)
        echo "ComfyUI disabled via COMFYUI_ENABLED=${COMFYUI_ENABLED}"
        COMFYUI_START_FLAG="${COMFYUI_START_FLAG:-/workspace/.start-comfyui}"
        echo "Waiting for start flag: ${COMFYUI_START_FLAG}"
        while [ ! -f "${COMFYUI_START_FLAG}" ]; do
            /usr/bin/sleep 5
        done
        echo "Start flag detected, launching ComfyUI"
        ;;
esac

cd /opt/workspace-internal/ComfyUI/

mkdir -p /workspace/basedir/custom_nodes
for node in /opt/workspace-internal/ComfyUI/custom_nodes/*; do
    [ -e "$node" ] || continue
    node_name=$(basename "$node")
    if [ ! -e "/workspace/basedir/custom_nodes/$node_name" ]; then
        echo "Copying built-in custom node $node_name to /workspace/basedir/custom_nodes/"
        cp -a "$node" "/workspace/basedir/custom_nodes/"
    fi
done

export LD_PRELOAD=libtcmalloc_minimal.so.4

USE_SAGE_FLAG=""
case "${SAGEATTENTION_USE:-1}" in
    1|true|True|TRUE|yes|Yes|YES|on|On|ON)
        if [ "${SAGEATTENTION_VERSION:-v2}" != "none" ]; then
            USE_SAGE_FLAG="--use-sage-attention"
        fi
        ;;
esac

exec python main.py --base-directory /workspace/basedir ${USE_SAGE_FLAG} ${COMFYUI_VRAM_FLAG} ${COMFYUI_ARGS}
