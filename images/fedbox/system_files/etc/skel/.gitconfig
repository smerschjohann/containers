# Personal git configuration - this file is yours.
# skel-sync installs it once and never overwrites it: identity and personal
# settings placed here survive image updates.
#
# Tool defaults (difftool, default branch, ...) live in the image and are
# included from /usr/share/home/gitconfig, so they stay current automatically.
# Anything set below wins over those defaults.

[include]
    path = /usr/share/home/gitconfig

# Your identity - git refuses to commit until this is set. Uncomment and adjust:
[user]
#    name  = Jane Doe
#    email = jane@example.org
